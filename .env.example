# Satpuda Core Server — copy to .env

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL (no Docker — native install)
DATABASE_URL=postgresql://satpuda:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/satpuda_core
PG_POOL_MAX=20

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# CORS — set your Cloudflare domain in production
CORS_ORIGINS=*

SYNC_WATERMARK_OVERLAP_SECONDS=120

# Deployment references
VPS_IP=200.234.32.222
GITHUB_REPO=https://github.com/roshanghogale/Satpuda-Core-Server.git
