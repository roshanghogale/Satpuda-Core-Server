{
  "name": "satpuda-core-server",
  "version": "1.0.0",
  "description": "Satpuda Core multi-store pharmacy API + admin dashboard (PostgreSQL)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:verify": "node src/db/verify.js",
    "admin:build": "cd admin && npm run build",
    "admin:dev": "cd admin && npm run dev",
    "setup": "npm install && node src/db/migrate.js && node src/db/seed.js && node src/db/verify.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  }
}
